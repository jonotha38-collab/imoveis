# Chave da OpenAI (a mesma que voce ja usa no n8n funciona)
OPENAI_API_KEY=sk-...

# Essas 2 sao preenchidas automaticamente pela Vercel quando voce cria
# um banco "Vercel KV" e conecta ao projeto - nao precisa preencher na mao
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Uma senha simples para proteger a pagina de upload (evita que qualquer
# pessoa que ache o link consiga subir arquivos)
SITE_PASSWORD=troque-por-uma-senha-forte
